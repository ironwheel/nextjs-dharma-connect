# Copy to .env for local runs (pnpm start / pnpm dry-run).
# On a server this file's contents go in /etc/neon-sync/neon-sync.env.

# AWS: uses the standard credential chain. Set AWS_PROFILE locally; omit on a host
# whose default credentials (or instance role) already grant table access.
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile

# Participant (student) table
STUDENT_TABLE=your-participant-table

# Neon CRM API v2 credentials (Settings > User Management > API access)
NEON_ORG_ID=your-neon-org-id
NEON_API_KEY=your-neon-api-key
# NEON_API_BASE_URL=https://api.neoncrm.com/v2

# Comma-separated, case-insensitive substrings. Neon accounts whose first/last name
# contains one are never created as participants (placeholder or internal accounts).
# NEON_SYNC_EXCLUDE_FIRST_NAMES=anonymous,example
# NEON_SYNC_EXCLUDE_LAST_NAMES=

# Sends within this many days are cleared when a participant's email changes,
# so they go out again to the new address.
# NEON_SYNC_RESEND_WINDOW_DAYS=7

# Safety limits: a run planning more than this many creates or email updates
# refuses to write unless given --force.
# NEON_SYNC_MAX_CREATES=25
# NEON_SYNC_MAX_EMAIL_UPDATES=25

# Optional: report each scheduled run to this Cronitor monitor (server only).
# CRONITOR_MONITOR=
